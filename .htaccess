RewriteEngine On

# MIME types para arquivos estáticos
AddType application/pdf .pdf

# Força HTTPS e WWW
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^www\.sprad\.com\.br$ [NC]
RewriteRule ^(.*)$ https://www.sprad.com.br/$1 [R=301,L]

# Sinalizações antigas -> novos arquivos
RewriteRule ^sinalizacoes/sinalizacao-luminosa\.pdf$ /sinalizacoes/luz-vermelha-entrada-proibida.pdf [R=301,L,NC]
RewriteRule ^sinalizacoes/suspeita-de-gravidez\.pdf$ /sinalizacoes/aviso-gravidez-exame-radiologico.pdf [R=301,L,NC]
RewriteRule ^sinalizacoes/pacientes-acompanhantes\.pdf$ /sinalizacoes/orientacoes-protecao-radiologica.pdf [R=301,L,NC]

# Remove /index ou /index.html e redireciona para a raiz limpa (/)
RewriteCond %{THE_REQUEST} \s/+(.*/)?index(\.html)?[\s?] [NC]
RewriteRule ^(.*/)?index(\.html)?$ /$1 [R=301,L]

# Redireciona URLs .html para versão limpa
RewriteCond %{THE_REQUEST} \s/+([^.]+)\.html[\s?] [NC]
RewriteRule ^([^.]+)\.html$ /$1 [R=301,L]

# Permite URLs sem .html pras outras páginas
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.*)$ $1.html [NC,L]