{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/cartao/(.*).vcf",
      "headers": [
        { "key": "Content-Type", "value": "text/vcard; charset=utf-8" },
        { "key": "Content-Disposition", "value": "attachment" }
      ]
    }
  ],
  "redirects": [
    { "source": "/sinalizacoes/sinalizacao-luminosa.pdf", "destination": "/sinalizacoes/luz-vermelha-entrada-proibida.pdf", "permanent": true },
    { "source": "/sinalizacoes/suspeita-de-gravidez.pdf", "destination": "/sinalizacoes/aviso-gravidez-exame-radiologico.pdf", "permanent": true },
    { "source": "/sinalizacoes/pacientes-acompanhantes.pdf", "destination": "/sinalizacoes/orientacoes-protecao-radiologica.pdf", "permanent": true }
  ]
}
